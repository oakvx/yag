{
    # LAN stack uses a static config. Do not expose Caddy's admin endpoint.
    admin off
    # TLS clients connecting to an IP literal often omit SNI. Select the
    # certificate for our explicit LAN address rather than aborting TLS.
    default_sni {$YAG_LAN_IP}
}

# The host publishes TCP 443 ONLY on the explicit private LAN address.
# Caddy issues an internal-CA certificate for that IP. Clients must trust
# the exported root certificate; do not disable TLS verification.
https://{$YAG_LAN_IP} {
    tls internal

    # Hub enforces live client keys, scheduling and admin authorization.
    # The browser dashboard is served through HTTPS only at /hub/.
    @control path /hub/*
    handle @control {
        reverse_proxy hub:8081
    }

    @api path /v1/* /api/*
    handle @api {
        reverse_proxy hub:8081 {
            flush_interval -1
        }
    }

    @health path /health
    handle @health {
        reverse_proxy yag:8080
    }

    handle {
        respond "Not found" 404
    }

    header {
        Strict-Transport-Security "max-age=31536000"
        X-Content-Type-Options "nosniff"
        -Server
    }
}
