{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "YAG Desktop",
  "version": "0.1.0",
  "identifier": "dev.yag.desktop",
  "build": {
    "beforeDevCommand": "npm run icons",
    "beforeBuildCommand": "npm run check && npm run icons",
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "YAG Desktop",
        "width": 1200,
        "height": 800,
        "minWidth": 800,
        "minHeight": 560,
        "backgroundColor": "#0d1014"
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src 'self' ipc: http://ipc.localhost; img-src 'self' data:; style-src 'self' 'unsafe-inline'; script-src 'self'"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "shortDescription": "Network-first AI model client",
    "category": "DeveloperTool"
  }
}
